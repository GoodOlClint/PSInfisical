# .env.example — Copy to .env and fill in values before running integration tests.
# Generate secrets with: openssl rand -hex 16 (ENCRYPTION_KEY) / openssl rand -base64 32 (AUTH_SECRET)

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=infisical
POSTGRES_PASSWORD=integration-test-password
POSTGRES_DB=infisical

# ---------------------------------------------------------------------------
# Infisical Core
# ---------------------------------------------------------------------------
# 32-hex-char key for encrypting secrets at rest. CRITICAL — if lost, secrets
# cannot be decrypted even with a database backup.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Signs JWT tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=dGhpcyBpcyBhbiBpbnRlZ3JhdGlvbiB0ZXN0IHNlY3JldA==

# Internal connection strings — match the service names in docker-compose.yml.
DB_CONNECTION_URI=postgres://infisical:integration-test-password@db:5432/infisical

REDIS_URL=redis://redis:6379

# Public URL of the Infisical instance as seen by the host / browser.
SITE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Port mappings (optional — defaults shown)
# ---------------------------------------------------------------------------
# INFISICAL_PORT=8080
# MOCK_429_PORT=8429

# ---------------------------------------------------------------------------
# Bootstrap admin account (used by Start-IntegrationEnvironment.ps1)
# ---------------------------------------------------------------------------
INFISICAL_ADMIN_EMAIL=admin@test.local
INFISICAL_ADMIN_PASSWORD=TestPassword123!

# ---------------------------------------------------------------------------
# SMTP (not needed for integration tests — leave blank)
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME=
# SMTP_USERNAME=
# SMTP_PASSWORD=
